# -----------------------------------------------------------------------------
# TaskFlow environment configuration
# Copy this file to `.env` and adjust the values for your machine.
# Never commit `.env` or real production credentials to version control.
# -----------------------------------------------------------------------------

APP_NAME="TaskFlow"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=task_tracker
DB_USER=root
DB_PASSWORD=

# Session lifetime in seconds (7200 = 2 hours of inactivity)
SESSION_NAME=taskflow_session
SESSION_LIFETIME=7200

# "auto" uses Secure cookies only when HTTPS is detected.
SESSION_SECURE=auto

# Failed-login throttling (per session)
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900

# Dashboard pagination
TASKS_PER_PAGE=8
